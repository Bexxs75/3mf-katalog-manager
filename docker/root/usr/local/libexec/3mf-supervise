#!/bin/bash
set -eu
runtime=$1
shift
child=
sleeper=
stop() {
    trap '' TERM INT
    if [ -n "$sleeper" ]; then
        kill -TERM "$sleeper" 2>/dev/null || :
        wait "$sleeper" 2>/dev/null || :
    fi
    if [ -n "$child" ]; then
        # WebKit children share the app's session and must stop with it.
        kill -TERM -- "-$child" 2>/dev/null || :
        wait "$child" 2>/dev/null || :
    fi
    rm -f "$runtime/app.pid"
    exit 0
}
trap stop TERM INT
pause=2
while :; do
    started=$SECONDS
    setsid "$@" &
    child=$!
    printf '%s\n' "$child" > "$runtime/app.pid"
    status=0
    wait "$child" || status=$?
    rm -f "$runtime/app.pid"
    kill -TERM -- "-$child" 2>/dev/null || :
    child=
    if (( SECONDS - started >= 60 )); then pause=2; fi
    printf 'App beendet / App exited (%s); Neustart in / restart in %s s.\n' "$status" "$pause"
    sleep "$pause" &
    sleeper=$!
    wait "$sleeper" || :
    sleeper=
    if (( pause < 30 )); then
        pause=$((pause * 2))
        if (( pause > 30 )); then pause=30; fi
    fi
done
