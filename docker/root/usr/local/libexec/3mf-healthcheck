#!/bin/bash
set -eu
[[ -r /run/3mf/app.pid ]] || exit 1
read -r pid < /run/3mf/app.pid
[[ $pid =~ ^[1-9][0-9]*$ ]] || exit 1
kill -0 "$pid" 2>/dev/null || exit 1
# A zombie has a PID but cannot serve the desktop.
[[ -r /proc/$pid/stat ]] || exit 1
state=$(cat "/proc/$pid/stat")
state=${state##*) }
[[ ${state%% *} != Z ]] || exit 1
# Only the response status is read; no credentials or response body are logged.
exec timeout 5 bash -c '
    exec 3<>/dev/tcp/127.0.0.1/3000 || exit 1
    printf "GET / HTTP/1.0\r\nHost: localhost\r\nConnection: close\r\n\r\n" >&3
    read -r protocol status rest <&3 || exit 1
    [[ $protocol == HTTP/* && ( $status == 200 || $status == 401 ) ]]
' >/dev/null 2>&1
