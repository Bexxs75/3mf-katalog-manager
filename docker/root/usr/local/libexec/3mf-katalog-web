UPLOAD_SCRIPT = """
(function () {
 const section = document.getElementById('upload');
 if (!section) return;
 const t = JSON.parse(section.dataset.text), queue = [];
 const input = document.getElementById('upload-input'), zone = document.getElementById('upload-zone');
 const list = document.getElementById('upload-list'), success = document.getElementById('upload-success');
 const items = [], clear = document.getElementById('upload-clear');
 let running = false;
 // Runs once the queue is drained: the summary sits next to the list so a rejection is visible without scrolling.
 function settle() {
  const count = s => items.filter(i => i.row.dataset.state === s).length;
  const ok = count('done'), bad = count('error');
  const parts = [];
  if (bad) parts.push(t.upload_summary.replace('{ok}', ok).replace('{bad}', bad));
  if (ok) parts.push(section.dataset.success);
  success.textContent = parts.join(' ');
  clear.hidden = false;
 }
 function pump() {
  if (running) return;
  const item = queue.shift();
  if (!item) return;
  if (item.cancelled) { pump(); return; }
  running = true;
  const xhr = new XMLHttpRequest(); item.xhr = xhr;
  item.status.textContent = t.upload_loading;
  item.row.dataset.state = 'loading';
  let finished = false;
  function finish(message, state) {
   if (finished) return;
   finished = true;
   item.status.textContent = message;
   item.row.dataset.state = state;
   item.cancel.hidden = true;
   if (state === 'done') item.progress.value = 100;
   running = false; pump();
   if (!running) settle();
  }
  xhr.open('POST', '/katalog/upload');
  xhr.setRequestHeader('Content-Type', 'application/octet-stream');
  xhr.setRequestHeader('X-Filename', encodeURIComponent(item.file.name));
  xhr.setRequestHeader('X-CSRF-Token', section.dataset.csrf);
  xhr.upload.onprogress = function (e) {
   if (e.lengthComputable) item.progress.value = e.loaded / e.total * 100;
  };
  xhr.onload = function () {
   let response = {};
   try { response = JSON.parse(xhr.responseText); } catch (e) {}
   if (xhr.status === 200 && response.ok) {
    item.name.textContent = response.name;
    finish(t.upload_done, 'done');
   } else {
    const codes = {401:'forbidden',403:'forbidden',404:'upload_disabled',413:'too_large',429:'busy',503:'write_failed'};
    finish(t.upload_error + ': ' + (t['upload_' + response.error] || t['upload_' + codes[xhr.status]] || t.upload_interrupted), 'error');
   }
  };
  xhr.onerror = function () { finish(t.upload_error + ': ' + t.upload_interrupted, 'error'); };
  xhr.onabort = function () { finish(t.upload_cancelled, 'cancelled'); };
  xhr.send(item.file);
 }
 function add(files) {
  for (const file of files) {
   const row = document.createElement('li'), name = document.createElement('strong');
   const size = document.createElement('span'), progress = document.createElement('progress');
   const status = document.createElement('p'), cancel = document.createElement('button');
   name.textContent = file.name;
   size.textContent = ' · ' + new Intl.NumberFormat(document.documentElement.lang).format(file.size) + ' B';
   progress.max = 100; progress.value = 0;
   progress.setAttribute('aria-label', t.upload_progress + ': ' + file.name);
   status.setAttribute('role', 'status'); status.textContent = t.upload_waiting;
   cancel.type = 'button'; cancel.textContent = t.cancel;
   cancel.setAttribute('aria-label', t.cancel + ': ' + file.name);
   row.dataset.state = 'waiting';
   const item = {file, name, progress, status, cancel, row, cancelled:false};
   cancel.onclick = function () {
    item.cancelled = true;
    if (item.xhr) item.xhr.abort();
    else { status.textContent = t.upload_cancelled; row.dataset.state = 'cancelled'; cancel.hidden = true; }
    choose.focus();
   };
   row.append(name, size, progress, status, cancel); list.append(row); queue.push(item); items.push(item);
  }
  clear.hidden = true; success.textContent = '';
  pump();
 }
 const choose = document.getElementById('upload-choose');
 choose.onclick = function () { input.click(); };
 clear.onclick = function () {
  items.length = 0; list.textContent = ''; success.textContent = ''; clear.hidden = true;
  choose.focus();
 };
 input.onchange = function () { add(input.files); input.value = ''; };
 zone.ondragover = function (e) { e.preventDefault(); zone.classList.add('drag'); };
 zone.ondragleave = function () { zone.classList.remove('drag'); };
 zone.ondrop = function (e) { e.preventDefault(); zone.classList.remove('drag'); add(e.dataTransfer.files); };
 section.hidden = false;
})();
"""


def escape(value):
    return html.escape(str(value), quote=True)


def language(header, chosen=None):
    # An explicit ?lang= wins over the browser; anything outside LANGS is ignored, never echoed.
    if chosen in LANGS:
        return chosen
    choices = []
    for index, entry in enumerate(header.split(',')):
        parts = entry.strip().lower().split(';')
        lang = parts[0].split('-')[0]
        quality = 1.0
        for part in parts[1:]:
            if part.strip().startswith('q='):
                try:
                    quality = float(part.strip()[2:])
                except ValueError:
                    quality = 0
        if lang in LANGS and 0 < quality <= 1:
            choices.append((quality, -index, lang))
    return max(choices)[2] if choices else 'de'


def discover_db(share=Path('/config/.local/share')):
    if 'CATALOG_DB' in os.environ:
        return os.environ['CATALOG_DB']
    try:
        candidates = [(p.stat().st_mtime_ns, str(p)) for p in Path(share).glob('*/catalog.db') if p.is_file()]
        return max(candidates)[1] if candidates else ''
    except OSError:
        return ''


def allowed_roots():
    if 'KATALOG_ALLOWED_ROOTS' in os.environ:
        return [p for p in os.environ['KATALOG_ALLOWED_ROOTS'].split(':') if os.path.isabs(p)]
    return [str(p) for p in Path('/').iterdir() if re.fullmatch(r'models[0-9]*', p.name)]


def load_secret(path=Path('/config/.katalog-web-secret')):
    path = Path(path)
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    except FileExistsError:
        pass
    else:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(secrets.token_bytes(32))
            stream.flush()
            os.fsync(stream.fileno())
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, 'rb') as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
            raise ValueError('Invalid secret owner or file type')
        os.fchmod(stream.fileno(), 0o600)
        secret = stream.read(33)
    if len(secret) != 32:
        raise ValueError('Invalid secret length')
    return secret


def origin(headers):
    host = headers.get('Host', '')
    if len(host) > 253 or not re.fullmatch(r'(?:[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?|\[[0-9A-Fa-f:]+\])(?::[0-9]{1,5})?', host):
        raise ValueError('Invalid host')
    parsed = urlsplit('http://' + host)
    if parsed.port is not None and not 1 <= parsed.port <= 65535:
        raise ValueError('Invalid port')
    if host.startswith('['):
        ipaddress.IPv6Address(parsed.hostname)
    proto = headers.get('X-Forwarded-Proto', 'http')
    if proto not in ('http', 'https'):
        raise ValueError('Invalid protocol')
    return proto + '://' + host


PUBLIC_ORIGIN = Path('/run/3mf/public-origin')
_origin_lock = threading.Lock()


def remember_origin(base):
    # Serialize comparison and replacement because requests run in parallel.
    temporary = None
    try:
        with _origin_lock:
            try:
                with PUBLIC_ORIGIN.open('r') as stream:
                    if stream.read(300) == base:
                        return
            except OSError:
                pass
            with tempfile.NamedTemporaryFile(mode='w', dir=PUBLIC_ORIGIN.parent,
                                             prefix='.public-origin-', delete=False) as stream:
                temporary = stream.name
                stream.write(base)
                stream.flush()
                os.fchmod(stream.fileno(), 0o644)
                os.fsync(stream.fileno())
            os.replace(temporary, PUBLIC_ORIGIN)
    except (OSError, UnicodeError):
        pass
    finally:
        if temporary is not None:
            with contextlib.suppress(OSError):
                os.unlink(temporary)


def filename(row):
    name = ''.join(c for c in str(row['name']) if not unicodedata.category(c).startswith('C'))
    name = name.replace('/', '_').replace('\\', '_') or 'model'
    return name


# Characters that are valid unencoded in a URL path segment.
SLICER_NAME_SAFE = frozenset('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._~+()!$\',;=@&')
SLICER_NAME_MAP = str.maketrans({'ß': 'ss', 'æ': 'ae', 'Æ': 'AE', 'ø': 'o', 'Ø': 'O', 'đ': 'd', 'Đ': 'D', 'ð': 'd', 'Ð': 'D',
                                 'þ': 'th', 'Þ': 'Th', 'œ': 'oe', 'Œ': 'OE', 'ł': 'l', 'Ł': 'L', 'ı': 'i'})
SLICER_NAME_STEM_MAX = 100


def slicer_url_name(name):
    """Last path segment of a slicer link, built so it never needs percent-encoding.

    The slicer decodes the file= parameter once and shows the last path segment of
    the resulting URL as the file name without decoding it again, so any encoded
    character would appear literally (%2B instead of +). The server ignores this
    segment and sends the real name in Content-Disposition, so it is display-only.
    """
    def clean(text):
        text = unicodedata.normalize('NFKD', text.translate(SLICER_NAME_MAP))
        text = ''.join(c if c in SLICER_NAME_SAFE else '_' for c in text if not unicodedata.combining(c))
        return re.sub('_+', '_', text)
    stem, ext = os.path.splitext(str(name))
    # Leading dots are dropped so the segment can never be "." or "..".
    stem = clean(stem).strip('_.')[:SLICER_NAME_STEM_MAX].rstrip('_.')
    return (stem or 'model') + clean(ext)


def list_url(query):
    kept = {k: v for k, v in query.items() if k in LIST_KEYS and v and (k != 'lang' or v in LANGS)}
    return '/katalog/' + ('?' + urlencode(kept) if kept else '')


def with_lang(url, code):
    # Same local list URL, with the language replaced; used by the language menu.
    pairs = parse_qs(urlsplit(safe_next(url)).query, max_num_fields=30, keep_blank_values=True)
    return list_url({**{k: v[0] for k, v in pairs.items()}, 'lang': code})


def safe_next(value):
    # Rebuilt from whitelisted keys, so the result is always a local list URL (no open redirect).
    try:
        url = urlsplit(value or '')
        pairs = parse_qs(url.query, max_num_fields=30, keep_blank_values=True)
    except ValueError:
        return '/katalog/'
    if url.scheme or url.netloc or url.path != '/katalog/' or any(c in value for c in '\\\r\n\t'):
        return '/katalog/'
    return list_url({k: v[0] for k, v in pairs.items()})


class HiddenStore:
    """IDs hidden from the download list; the catalog database itself is never written."""

    def __init__(self, path=None):
        self.path = Path(path or os.environ.get('KATALOG_WEB_HIDDEN') or HIDDEN_FILE)
        self.lock = threading.Lock()

    def _read(self):
        try:
            with open(self.path, 'rb') as stream:
                data = json.loads(stream.read(4_000_000))
        except (OSError, ValueError):
            return set()
        valid = (isinstance(data, list) and len(data) <= HIDDEN_LIMIT and
                 all(type(i) is int and 0 <= i <= 9223372036854775807 for i in data))
        return set(data) if valid else set()

    def _write(self, ids):
        # Same-directory temp file + replace: readers see the old or the new list, never a partial one.
        fd, temporary = tempfile.mkstemp(dir=self.path.parent, prefix='.katalog-web-hidden-')
        try:
            with os.fdopen(fd, 'w') as stream:
                os.fchmod(stream.fileno(), 0o600)
                json.dump(sorted(ids), stream)
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(temporary, self.path)
        except BaseException:
            with contextlib.suppress(OSError):
                os.unlink(temporary)
            raise

    def ids(self):
        with self.lock:
            return frozenset(self._read())

    def change(self, fid, hide):
        """Returns False when the list is full; raises OSError when it cannot be saved."""
        with self.lock:
            ids = self._read()
            if (fid in ids) == hide:
                return True
            if hide and len(ids) >= HIDDEN_LIMIT:
                return False
            ids.add(fid) if hide else ids.discard(fid)
            self._write(ids)
            return True


class UploadError(Exception):
    def __init__(self, status, code):
        self.status, self.code = status, code


def upload_name(encoded):
    try:
        if re.search(r'%(?![0-9a-fA-F]{2})', encoded):
            raise ValueError
        name = unicodedata.normalize('NFC', unquote_to_bytes(encoded).decode('utf-8'))
        if (not name or name.startswith('.') or (name != name.strip() or name.endswith('.')) or
                any(c in '/\\' or unicodedata.category(c).startswith('C') for c in name) or
                len(name) > 180 or len(name.encode('utf-8')) > 240):
            raise ValueError
    except (ValueError, UnicodeError):
        raise UploadError(400, 'invalid_name') from None
    if Path(name).suffix.lower() not in UPLOAD_EXTENSIONS:
        raise UploadError(415, 'unsupported_type')
    return name


def upload_signature(name, block):
    if not block:
        raise UploadError(400, 'invalid_content')
    ext = Path(name).suffix.lower()
    signatures = {'.3mf': b'PK\x03\x04', '.zip': b'PK\x03\x04',
                  '.7z': b"7z\xbc\xaf\x27\x1c", '.rar': b'Rar!\x1a\x07'}
    if ext in signatures:
        valid = block.startswith(signatures[ext])
    elif ext in ('.stp', '.step'):
        valid = block.lstrip().startswith(b'ISO-10303-21')
    else:
        valid = not block.startswith((b'MZ', b'\x7fELF', b'#!'))
    if not valid:
        raise UploadError(415, 'invalid_signature')


class Catalog:
    def __init__(self, db_path=None, roots=None, secret=None, hidden=None):
        self.db_path = db_path
        self.hidden = HiddenStore(hidden)
        self.roots = [os.path.abspath(p) for p in (allowed_roots() if roots is None else roots)]
        self.secret = load_secret() if secret is None else secret
        self.upload_dir = os.environ.get('KATALOG_UPLOAD_DIR') or '/models/Eingang'
        try:
            self.upload_max = int(os.environ.get('KATALOG_UPLOAD_MAX_MB') or '2048') * UPLOAD_BLOCK
        except ValueError:
            self.upload_max = 0
        self.upload_slots = threading.BoundedSemaphore(2)
        self.cleanup_uploads()

    def upload_csrf(self):
        return hmac.new(self.secret, b'upload|csrf', hashlib.sha256).hexdigest()

    def upload_allowed(self, path):
        return any(os.path.commonpath([root, path]) == root for root in self.roots)

    def upload_problem(self):
        if self.upload_max <= 0:
            return 'upload_config'
        if not os.path.isabs(self.upload_dir):
            return 'upload_root'
        target = os.path.realpath(self.upload_dir)
        if not self.upload_allowed(target):
            return 'upload_root'
        parent = target
        while not os.path.exists(parent):
            parent = os.path.dirname(parent)
        try:
            if not os.path.isdir(parent) or not os.access(parent, os.W_OK | os.X_OK):
                return 'upload_permissions'
            if os.statvfs(parent).f_flag & os.ST_RDONLY:
                return 'upload_permissions'
        except OSError:
            return 'upload_permissions'
        return None

    @contextlib.contextmanager
    def upload_folder(self, create=False):
        if self.upload_problem():
            raise UploadError(404, 'upload_disabled')
        target = os.path.realpath(self.upload_dir)
        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
        fd = os.open('/', flags)
        try:
            # Walk pinned parents so a swapped symlink cannot redirect directory creation.
            for component in Path(target).parts[1:]:
                try:
                    child = os.open(component, flags, dir_fd=fd)
                except FileNotFoundError:
                    if not create:
                        raise
                    parent = os.path.realpath(f'/proc/self/fd/{fd}')
                    if not self.upload_allowed(os.path.join(parent, component)):
                        raise UploadError(404, 'upload_disabled') from None
                    os.makedirs(f'/proc/self/fd/{fd}/{component}', mode=0o755, exist_ok=True)
                    child = os.open(component, flags, dir_fd=fd)
                os.close(fd)
                fd = child
            # Pin the directory and recheck the opened inode, not a replaceable path.
            if not self.upload_allowed(os.path.realpath(f'/proc/self/fd/{fd}')):
                raise UploadError(404, 'upload_disabled')
            yield fd
        finally:
            os.close(fd)

    def cleanup_uploads(self):
        try:
            with self.upload_folder() as directory:
                for name in os.listdir(directory):
                    if re.fullmatch(r'\.upload-[a-zA-Z0-9_-]+\.part', name):
                        info = os.stat(name, dir_fd=directory, follow_symlinks=False)
                        if stat.S_ISREG(info.st_mode) and info.st_mtime < time.time() - 3600:
                            os.unlink(name, dir_fd=directory)
        except (OSError, UploadError):
            pass

    def receive_upload(self, source, length, name, extra=lambda: False):
        if length > self.upload_max:
            raise UploadError(413, 'too_large')
        if length <= 0:
            raise UploadError(400, 'invalid_content')
        with self.upload_folder(create=True) as directory:
            space = os.statvfs(directory)
            if space.f_bavail * space.f_frsize <= length + UPLOAD_RESERVE:
                raise UploadError(409, 'no_space')
            temporary = '.upload-' + secrets.token_hex(16) + '.part'
            fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644, dir_fd=directory)
            try:
                with os.fdopen(fd, 'wb') as stream:
                    os.fchmod(stream.fileno(), 0o644)
                    total = 0
                    while total < length:
                        block = source.read(min(UPLOAD_BLOCK, length - total))
                        if not block or len(block) > length - total:
                            raise UploadError(400, 'length_mismatch')
                        if total == 0:
                            upload_signature(name, block)
                        total += len(block)
                        stream.write(block)
                    if extra():
                        raise UploadError(400, 'length_mismatch')
                    stream.flush()
                    os.fsync(stream.fileno())
                stem, ext = os.path.splitext(name)
                for attempt in range(1, 101):
                    final = name if attempt == 1 else f'{stem} ({attempt}){ext}'
                    try:
                        os.link(temporary, final, src_dir_fd=directory, dst_dir_fd=directory, follow_symlinks=False)
                        return {'ok': True, 'name': final, 'size': total}
                    except FileExistsError:
                        continue
                raise UploadError(409, 'conflict')
            finally:
                os.unlink(temporary, dir_fd=directory)

    @contextlib.contextmanager
    def connect(self):
        path = discover_db() if self.db_path is None else self.db_path
        if not path:
            raise sqlite3.OperationalError('No catalog')
        con = sqlite3.connect(Path(path).absolute().as_uri() + '?mode=ro', uri=True, timeout=2)
        con.row_factory = sqlite3.Row
        deadline = time.monotonic() + 2
        con.set_progress_handler(lambda: time.monotonic() > deadline, 1000)
        try:
            yield con
        finally:
            con.close()

    def token(self, fid, expiry=None):
        expiry = int(time.time()) + 3600 if expiry is None else expiry
        message = f'{fid}|{expiry}|download'.encode()
        return f'{expiry}.' + hmac.new(self.secret, message, hashlib.sha256).hexdigest()

    def valid_token(self, fid, token):
        if not re.fullmatch(r'[0-9]{1,12}\.[0-9a-f]{64}', token):
            return False
        expiry = int(token.split('.')[0])
        return expiry > int(time.time()) and hmac.compare_digest(self.token(fid, expiry), token)

    def csrf(self, fid):
        # Distinct purpose text keeps these tokens and download tokens from being interchangeable.
        return hmac.new(self.secret, f'csrf|{fid}'.encode(), hashlib.sha256).hexdigest()

    def valid_csrf(self, fid, token):
        return hmac.compare_digest(self.csrf(fid), token)

    def file(self, fid, include_hidden=False):
        if not re.fullmatch(ID, fid) or int(fid) > 9223372036854775807:
            return None
        if not include_hidden and int(fid) in self.hidden.ids():
            return None
        try:
            with self.connect() as con:
                return con.execute('SELECT id, name, path, file_type, thumbnail_png FROM files WHERE id=? AND deleted_at IS NULL', (int(fid),)).fetchone()
        except (sqlite3.Error, OSError, ValueError):
            return None

    def open_file(self, row):
        if row is None:
            raise FileNotFoundError
        path = row['path']
        if not isinstance(path, str) or not os.path.isabs(path) or '..' in Path(path).parts or '\x00' in path:
            raise FileNotFoundError
        resolved = os.path.realpath(path)
        if not any(os.path.commonpath([root, resolved]) == root and resolved != root for root in self.roots):
            raise FileNotFoundError
        # Walk the resolved path with directory descriptors to close symlink-swap races.
        fd = os.open('/', os.O_RDONLY | os.O_DIRECTORY)
        try:
            components = Path(resolved).parts[1:]
            for part in components[:-1]:
                next_fd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
                os.close(fd)
                fd = next_fd
            result = os.open(components[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)
        finally:
            os.close(fd)
        stream = os.fdopen(result, 'rb')
        if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
            stream.close()
            raise FileNotFoundError
        return stream

    def listing(self, query):
        if 'file' in query:
            row = self.file(query['file'])
            with self.open_file(row):
                pass
        view_hidden = query.get('hidden') == '1' and 'file' not in query
        hidden_json = json.dumps(sorted(self.hidden.ids()))
        where = ['f.deleted_at IS NULL', 'f.id ' + ('IN' if view_hidden else 'NOT IN') + ' (SELECT value FROM json_each(?))']
        args = [hidden_json]
        if 'file' in query:
            where.append('f.id=?')
            args.append(int(query['file']))
        if query.get('q'):
            where.append('instr(lower(f.name), lower(?)) > 0')
            args.append(query['q'])
        for key, column in [('type', 'f.file_type'), ('folder', 'f.folder_id')]:
            if query.get(key):
                where.append(column + '=?')
                args.append(query[key])
        if query.get('tag'):
            where.append('EXISTS (SELECT 1 FROM file_tags ft WHERE ft.file_id=f.id AND ft.tag_id=?)')
            args.append(query['tag'])
        sort = {'name': 'f.name COLLATE NOCASE ASC', 'newest': 'f.imported_at DESC', 'size': 'f.file_size_bytes DESC'}.get(query.get('sort'), 'f.name COLLATE NOCASE ASC')
        try:
            page = min(max(int(query.get('page', '1')), 1), 1000000)
        except ValueError:
            page = 1
        with self.connect() as con:
            rows = con.execute('SELECT f.id, f.name, f.path, f.file_type, f.file_size_bytes, '
                               'f.thumbnail_png IS NOT NULL AS has_thumb, d.name AS folder '
                               'FROM files f LEFT JOIN folders d ON f.folder_id=d.id WHERE ' +
                               ' AND '.join(where) + ' ORDER BY ' + sort + ', f.id ASC LIMIT ? OFFSET ?',
                               args + [PAGE_SIZE + 1, (page - 1) * PAGE_SIZE]).fetchall()
            folders = con.execute('SELECT id, name FROM folders ORDER BY name').fetchall()
            tags = con.execute('SELECT id, name FROM tags ORDER BY name').fetchall()
            hidden_count = con.execute('SELECT count(*) FROM files f WHERE f.deleted_at IS NULL AND f.id IN (SELECT value FROM json_each(?))',
                                       (hidden_json,)).fetchone()[0]
            tagged = {}
            for row in rows[:PAGE_SIZE]:
                tagged[row['id']] = [r[0] for r in con.execute('SELECT t.name FROM tags t JOIN file_tags ft ON t.id=ft.tag_id WHERE ft.file_id=? ORDER BY t.name', (row['id'],))]
        return rows[:PAGE_SIZE], len(rows) > PAGE_SIZE, page, folders, tags, tagged, hidden_count


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = 'KatalogWeb'
    sys_version = ''

    def setup(self):
        self.request.settimeout(10)
        super().setup()

    def parse_request(self):
        result = super().parse_request()
        if result and len(self.raw_requestline) > 8192:
            self.send_error(414)
            return False
        return result

    def end_headers(self):
        self.send_header('Content-Security-Policy', CSP)
        self.send_header('X-Content-Type-Options', 'nosniff')
        self.send_header('Referrer-Policy', 'no-referrer')
        super().end_headers()

    def log_request(self, code='-', size='-'):
        path = getattr(self, 'path', '').split('?', 1)[0]
        route = next((p for p in ('signed', 'download', 'thumb', 'health') if path.startswith('/katalog/' + p + '/')), 'page')
        if path in ('/katalog/remove', '/katalog/restore', '/katalog/upload'):
            route = path.rsplit('/', 1)[1]
        method = self.command if self.command in ('GET', 'HEAD', 'POST') else 'OTHER'
        print(f'{method} /katalog/{route} {code}', flush=True)

    def log_message(self, format, *args):
        # Base errors can include the raw request and credentials in malformed URLs.
        pass

    def respond(self, status, body=b'', content_type='text/plain; charset=utf-8', cache='no-store', headers=None):
        self.send_response(status)
        self.send_header('Content-Type', content_type)
        self.send_header('Content-Length', str(len(body)))
        self.send_header('Cache-Control', cache)
        for key, value in (headers or {}).items():
            self.send_header(key, value)
        self.end_headers()
        if getattr(self, 'command', '') != 'HEAD':
            self.wfile.write(body)

    def send_error(self, code, message=None, explain=None):
        self.close_connection = True
        try:
            chosen = parse_qs(urlsplit(getattr(self, 'path', '')).query).get('lang', [''])[0]
        except ValueError:
            chosen = None
        lang = language(getattr(self, 'headers', {}).get('Accept-Language', ''), chosen)
        self.respond(code, TEXT['error'][LANGS.index(lang)].encode())

    def method_not_allowed(self):
        self.close_connection = True
        self.respond(405, headers={'Allow': 'GET, HEAD'})

    def __getattr__(self, name):
        if name.startswith('do_'):
            return self.method_not_allowed
        raise AttributeError(name)

    def do_HEAD(self):
        self.do_GET()

    def do_POST(self):
        try:
            self.post()
        except (BrokenPipeError, ConnectionResetError, TimeoutError):
            self.close_connection = True

    def post(self):
        app = self.server.catalog
        try:
            path = urlsplit(self.path).path
        except ValueError:
            self.send_error(400)
            return
        if path == '/katalog/upload':
            self.upload()
            return
        if path not in ('/katalog/remove', '/katalog/restore'):
            self.method_not_allowed()
            return
        # The browser attaches the login automatically, so a foreign page could submit this form.
        # Origin/Referer must name this host, and the token is checked either way.
        host = self.headers.get('Host', '').lower()
        # With Referrer-Policy: no-referrer browsers send "Origin: null" for same-site form posts;
        # that carries no host to compare, so only the per-file token decides then.
        origin = self.headers.get('Origin')
        source = (None if origin == 'null' else origin) or self.headers.get('Referer')
        if source is not None:
            try:
                same = bool(host) and urlsplit(source).netloc.lower() == host
            except ValueError:
                same = False
            if not same:
                self.send_error(403)
                return
        length = self.headers.get('Content-Length', '')
        if 'Transfer-Encoding' in self.headers or not re.fullmatch(r'[0-9]{1,9}', length):
            self.send_error(411 if 'Transfer-Encoding' not in self.headers else 400)
            return
        if int(length) > MAX_BODY:
            self.send_error(413)
            return
        if self.headers.get('Content-Type', '').split(';')[0].strip().lower() != 'application/x-www-form-urlencoded':
            self.send_error(415)
            return
        try:
            body = self.rfile.read(int(length))
            if len(body) != int(length):
                raise ValueError
            form = parse_qs(body.decode('ascii'), keep_blank_values=True, max_num_fields=10, strict_parsing=bool(body))
            if any(len(form.get(k, [''])) != 1 for k in ('id', 'csrf', 'next')):
                raise ValueError
        except (ValueError, UnicodeError):
            self.send_error(400)
            return
        fid = form.get('id', [''])[0]
        if not re.fullmatch(ID, fid) or int(fid) > 9223372036854775807:
            self.send_error(400)
            return
        if not app.valid_csrf(fid, form.get('csrf', [''])[0]):
            self.send_error(403)
            return
        hide = path == '/katalog/remove'
        if app.file(fid, include_hidden=True) is None and not (not hide and int(fid) in app.hidden.ids()):
            self.send_error(404)
            return
        try:
            saved = app.hidden.change(int(fid), hide)
        except OSError:
            self.send_error(503)
            return
        if not saved:
            self.send_error(409)
            return
        target = safe_next(form.get('next', [''])[0])
        if hide:
            target += ('&' if '?' in target else '?') + urlencode({'removed': fid})
        elif not app.hidden.ids():
            # Leaving the hidden view empty would show a dead page; go back to the list, keeping the language.
            pairs = parse_qs(urlsplit(target).query, keep_blank_values=True)
            if pairs.get('hidden') == ['1'] and set(pairs) <= {'hidden', 'lang'}:
                target = list_url({'lang': pairs.get('lang', [''])[0]})
        self.respond(303, headers={'Location': target})

    def upload(self):
        app = self.server.catalog
        self.close_connection = True
        acquired = False
        try:
            source = self.headers.get('Origin')
            source = (None if source == 'null' else source) or self.headers.get('Referer')
            try:
                if source is not None and (not self.headers.get('Host') or
                        urlsplit(source).netloc.lower() != self.headers['Host'].lower()):
                    raise ValueError
            except ValueError:
                raise UploadError(403, 'forbidden') from None
            token = self.headers.get('X-CSRF-Token', '')
            if not re.fullmatch(r'[0-9a-f]{64}', token) or not hmac.compare_digest(token, app.upload_csrf()):
                raise UploadError(403, 'forbidden')
            lengths = self.headers.get_all('Content-Length', [])
            if len(lengths) != 1 or not re.fullmatch(r'[0-9]{1,20}', lengths[0]):
                raise UploadError(411, 'length_required')
            if 'Transfer-Encoding' in self.headers:
                raise UploadError(400, 'length_mismatch')
            length = int(lengths[0])
            if length > app.upload_max:
                raise UploadError(413, 'too_large')
            if self.headers.get('Content-Type', '').lower() != 'application/octet-stream':
                raise UploadError(415, 'unsupported_type')
            name = upload_name(self.headers.get('X-Filename', ''))
            if app.upload_problem():
                raise UploadError(404, 'upload_disabled')
            acquired = app.upload_slots.acquire(blocking=False)
            if not acquired:
                raise UploadError(429, 'busy')
            self.connection.settimeout(60)

            def extra():
                # HTTP frames the body by length; only already available surplus is observable.
                self.connection.settimeout(0)
                try:
                    return bool(self.rfile.read(1))
                except (BlockingIOError, TimeoutError):
                    return False
                finally:
                    self.connection.settimeout(60)

            result = app.receive_upload(self.rfile, length, name, extra)
            status = 200
        except UploadError as error:
            status, result = error.status, {'ok': False, 'error': error.code}
        except (TimeoutError, ConnectionError):
            status, result = 400, {'ok': False, 'error': 'interrupted'}
        except OSError:
            status, result = 503, {'ok': False, 'error': 'write_failed'}
        finally:
            self.connection.settimeout(10)
            if acquired:
                app.upload_slots.release()
        self.respond(status, json.dumps(result).encode(), 'application/json', headers={'Connection': 'close'})

    def do_GET(self):
        try:
            self.route()
        except (BrokenPipeError, ConnectionResetError, TimeoutError):
            self.close_connection = True

    def route(self):
        app = self.server.catalog
        try:
            url = urlsplit(self.path)
        except ValueError:
            self.send_error(400)
            return
        path = url.path
        if path == '/katalog/health':
            self.respond(200, b'ok\n')
            return
        if path.startswith('/katalog/static/'):
            self.asset(path[len('/katalog/static/'):])
            return
        if path == '/katalog/':
            try:
                base = origin(self.headers)
                query = {k: v[0] for k, v in parse_qs(url.query, max_num_fields=30, keep_blank_values=True).items() if k in LIST_KEYS + ('file', 'removed')}
                if query.get('lang') not in LANGS:
                    query.pop('lang', None)
            except ValueError:
                self.send_error(400)
                return
            remember_origin(base)
            if 'file' in query:
                values = parse_qs(url.query, keep_blank_values=True)['file']
                query = {'file': values[0] if len(values) == 1 else '', **({'lang': query['lang']} if 'lang' in query else {})}
            self.page(base, query)
            return
        if path == '/katalog/remove':
            self.confirm_page(parse_qs(url.query, keep_blank_values=True))
            return
        signed = path.startswith('/katalog/signed/')
        if signed:
            match = re.fullmatch(r'/katalog/signed/(' + ID + r')/([^/]+)/[^/]+', path)
            if not match:
                self.send_error(403)
                return
            fid, token = match.groups()
            if not app.valid_token(fid, token):
                self.send_error(403)
                return
            action = 'signed'
        else:
            match = re.fullmatch(r'/katalog/(download|thumb)/(' + ID + ')', path)
            if not match:
                self.send_error(404)
                return
            action, fid = match.groups()
        row = app.file(fid)
        try:
            stream = app.open_file(row)
        except (OSError, ValueError):
            self.send_error(404)
            return
        with stream:
            if action == 'thumb':
                png = row['thumbnail_png']
                if not isinstance(png, bytes) or not png:
                    self.send_error(404)
                else:
                    self.respond(200, png, 'image/png', 'private')
                return
            size = os.fstat(stream.fileno()).st_size
            self.send_response(200)
            self.send_header('Content-Type', MIME.get(row['file_type'], 'application/octet-stream'))
            self.send_header('Content-Length', str(size))
            self.send_header('Content-Disposition', ('inline' if signed else 'attachment') + "; filename*=UTF-8''" + quote(filename(row), safe=''))
            self.send_header('Cache-Control', 'no-store')
            self.end_headers()
            if self.command != 'HEAD':
                remaining = size
                while remaining:
                    block = stream.read(min(BLOCK_SIZE, remaining))
                    if not block:
                        break
                    self.wfile.write(block)
                    remaining -= len(block)

    def asset(self, name):
        entry = ASSETS.get(name)
        try:
            body = (SHARE / entry[0]).read_bytes() if entry else None
        except OSError:
            body = None
        if body is None:
            self.send_error(404)
            return
        self.respond(200, body, entry[1], entry[2])

    def chrome(self, lang, home, switch):
        # home: local URL of the list in the current language; switch: language code -> URL of this page in that language.
        def t(key):
            return TEXT[key][LANGS.index(lang)]
        parts = [f'<!doctype html><html lang="{lang}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">',
                 '<link rel="icon" type="image/png" sizes="32x32" href="/katalog/static/icon-32.png">'
                 '<link rel="apple-touch-icon" href="/katalog/static/icon-128.png">',
                 f'<title>{t("title")}</title><script>{THEME_SCRIPT}</script><style>{STYLE}</style></head><body>']
        parts.append(f'<header class="bar"><a class="brand" href="{escape(home)}"><img src="/katalog/static/icon-128.png" width="30" height="30" alt=""><span>3MF Katalog</span></a>')
        names = {'wiki': 'Wiki', 'homepage': t('homepage'), 'discord': 'Discord'}
        links = ''.join(f'<a href="{escape(de_url if lang == 'de' else en_url)}" target="_blank" rel="noopener noreferrer">{escape(names[key])}</a>'
                        for key, de_url, en_url in EXTERNAL)
        # Hidden until the script runs, so a page without JavaScript shows no dead control.
        toggle = (f'<button type="button" class="theme" id="theme-toggle" hidden data-state="auto" data-label="{escape(t("theme"))}" '
                  f'data-auto="{escape(t("theme_auto"))}" data-light="{escape(t("theme_light"))}" data-dark="{escape(t("theme_dark"))}">'
                  + ''.join(ICON_THEMES.values()) + '</button>')
        current = ' aria-current="true"'
        menu = ''.join(f'<a href="{escape(switch(code))}" lang="{code}" hreflang="{code}" title="{LANG_NAMES[code]}" '
                       f'aria-label="{LANG_NAMES[code]}"{current if code == lang else ""}>{FLAGS[code]}</a>' for code in LANGS)
        parts.append(f'<div class="bar-end">{toggle}<nav class="langs" aria-label="{escape(t("language"))}">{menu}</nav>'
                     f'<nav class="ext" aria-label="{escape(t("ext_links"))}">{links}</nav></div></header><main>')
        return ''.join(parts)

    def hidden_fields(self, fid, nxt):
        app = self.server.catalog
        return (f'<input type="hidden" name="id" value="{fid}"><input type="hidden" name="csrf" value="{app.csrf(fid)}">'
                f'<input type="hidden" name="next" value="{escape(nxt)}">')

    def confirm_page(self, params):
        fid = params.get('id', [''])[0]
        nxt = safe_next(params.get('next', [''])[0])
        nxt_lang = parse_qs(urlsplit(nxt).query).get('lang', [''])[0]
        chosen = params.get('lang', [''])[0]
        lang = language(self.headers.get('Accept-Language', ''), chosen if chosen in LANGS else nxt_lang)
        explicit = lang if (chosen in LANGS or nxt_lang in LANGS) else ''
        home = list_url({'lang': explicit})
        def t(key):
            return TEXT[key][LANGS.index(lang)]
        row = self.server.catalog.file(fid)
        if row is None:
            body = f'<p role="status">{t("file_missing")}</p>'
            status = 404
        else:
            body = (f'<div class="confirm"><h2>{t("remove_title")}</h2><p class="dlg-name">{escape(row["name"])}</p><p>{t("remove_explain")}</p>'
                    f'<form method="post" action="/katalog/remove">{self.hidden_fields(fid, nxt)}'
                    f'<button type="submit">{t("remove_confirm")}</button><a href="{escape(nxt)}">{t("cancel")}</a></form></div>')
            status = 200
        def switch(code):
            return '/katalog/remove?' + urlencode({'id': fid, 'next': with_lang(nxt, code), 'lang': code})
        html_text = (self.chrome(lang, home, switch) + f'<p class="back"><a href="{escape(nxt)}">{t("back_list")}</a></p><h1>{t("title")}</h1>' + body +
                     f'</main><script>{SCRIPT}</script></body></html>')
        self.respond(status, html_text.encode(), 'text/html; charset=utf-8')

    def upload_section(self, lang):
        app = self.server.catalog
        def t(key):
            return TEXT[key][LANGS.index(lang)]
        problem = app.upload_problem()
        if problem:
            return f'<p role="status">{escape(t(problem))}</p>'
        texts = {k: v[LANGS.index(lang)] for k, v in TEXT.items() if k.startswith('upload_') or k == 'cancel'}
        target = os.path.realpath(app.upload_dir)
        success = t('upload_success').format(folder=os.path.basename(target), path=target)
        accept = ','.join(sorted(UPLOAD_EXTENSIONS))
        return (f'<section class="upload" id="upload" hidden aria-labelledby="upload-title" '
                f'data-csrf="{app.upload_csrf()}" data-text="{escape(json.dumps(texts))}" data-success="{escape(success)}">'
                f'<h2 id="upload-title">{t("upload_title")}</h2>'
                f'<p>{escape(t("upload_limits").format(mb=app.upload_max // UPLOAD_BLOCK))}</p>'
                f'<div class="upload-zone" id="upload-zone"><p>{t("upload_drop")}</p>'
                f'<input id="upload-input" type="file" multiple accept="{accept}" hidden>'
                f'<button type="button" id="upload-choose">{t("upload_choose")}</button></div>'
                '<ul class="upload-list" id="upload-list"></ul>'
                f'<button type="button" class="secondary" id="upload-clear" hidden>{t("upload_clear")}</button>'
                '<p id="upload-success" role="status" tabindex="0"></p></section>'
                f'<noscript><p>{t("upload_nojs")}</p></noscript>')

    def page(self, base, query):
        lang = language(self.headers.get('Accept-Language', ''), query.get('lang'))
        explicit = query.get('lang', '')
        def t(key):
            return TEXT[key][LANGS.index(lang)]
        app = self.server.catalog
        home = list_url({'lang': explicit})
        def switch(code):
            return '/katalog/?' + urlencode({**query, 'lang': code})
        lang_field = '<input type=hidden name=lang value=%s>' % explicit if explicit else ''
        parts = [self.chrome(lang, home, switch)]
        status = 200
        single = 'file' in query
        view_hidden = query.get('hidden') == '1' and not single
        here = list_url(query) if not single else home
        if single:
            parts.append(f'<p class="back"><a href="{escape(home)}">{t("all_files")}</a></p>')
        parts.append(f'<h1>{t("hidden_title") if view_hidden else t("title")}</h1>')
        if not single:
            parts.append(self.upload_section(lang))
        removed = query.get('removed', '')
        if re.fullmatch(ID, removed) and not single:
            row = app.file(removed, include_hidden=True)
            if row is not None and int(removed) in app.hidden.ids():
                message = t('removed').format(name=escape(row['name']))
                # A form cannot sit inside <p>, so the button points at the form that follows.
                parts.append(f'<p role="status">{message} <button class="link" type="submit" form="undo-form">{t("undo")}</button></p>'
                             f'<form id="undo-form" class="inline" method="post" action="/katalog/restore">{self.hidden_fields(removed, here)}</form>')
        parts.append(f'<aside class="notice" role="note" aria-labelledby="notice-title"><svg {ICON_ATTRS}><circle cx="12" cy="12" r="9.5"/><path d="M12 11v6M12 7.5h.01"/></svg><div><h2 id="notice-title">{t("notice")}</h2><p>{t("expiry")}</p><p>{t("prusa")}</p><details><summary>{t("help")}</summary><p>{t("advice")}</p></details></div></aside>')
        try:
            rows, more, page, folders, tags, tagged, hidden_count = app.listing(query)
        except (sqlite3.Error, OSError, ValueError):
            status = 404 if single else 200
            parts.append(f'<p role="status">{t("file_missing" if single else "missing")}</p>')
        else:
            if not single:
                parts.append(f'<form method="get" action="/katalog/">{"<input type=hidden name=hidden value=1>" if view_hidden else ""}{lang_field}<label>{t("search")}<input name="q" value="{escape(query.get("q", ""))}" maxlength="200"></label>')
                choices = [('type', [(v, v.upper()) for v in ('3mf', 'stl', 'stp', 'obj')]), ('folder', folders), ('tag', tags), ('sort', [(v, t(v)) for v in ('name', 'newest', 'size')])]
                for key, options in choices:
                    parts.append(f'<label>{t(key)}<select name="{key}">')
                    if key != 'sort':
                        parts.append(f'<option value="">{t("all")}</option>')
                    for value, label in options:
                        selected = ' selected' if str(value) == query.get(key, '') else ''
                        parts.append(f'<option value="{escape(value)}"{selected}>{escape(label)}</option>')
                    parts.append('</select></label>')
                parts.append(f'<button type="submit">{t("apply")}</button></form>')
                if view_hidden:
                    parts.append(f'<p><a href="{escape(home)}">{t("back_list")}</a></p>')
                elif hidden_count:
                    parts.append(f'<p><a href="{escape(list_url({"hidden": "1", "lang": explicit}))}">{escape(t("show_hidden").format(n=hidden_count))}</a></p>')
            parts.append('<ul class="files">')
            for row in rows:
                fid = str(row['id'])
                if view_hidden:
                    available = True
                else:
                    try:
                        with app.open_file(row):
                            pass
                        available = True
                    except (OSError, ValueError):
                        available = False
                parts.append('<li class="file' + ('' if available else ' unavailable') + '">')
                if row['has_thumb'] and available and not view_hidden:
                    parts.append(f'<img src="/katalog/thumb/{fid}" alt="" loading="lazy">')
                else:
                    # Same box as the thumbnail so cards stay uniform; the type is also in the text below.
                    parts.append(f'<div class="ph" aria-hidden="true">{ICON_MODEL}<span>{escape(str(row["file_type"]).upper())}</span></div>')
                parts.append(f'<div class="content"><h2>{escape(row["name"])}</h2><p class="meta">{escape(row["file_type"])} · {escape(row["file_size_bytes"])} B · {escape(row["folder"] or "")}</p>')
                if tagged[row['id']]:
                    parts.append('<p class="tags">' + ''.join(f'<span class="tag">{escape(tag)}</span>' for tag in tagged[row['id']]) + '</p>')
                if view_hidden:
                    parts.append(f'<div class="actions"><form class="inline" method="post" action="/katalog/restore">{self.hidden_fields(fid, here)}'
                                 f'<button class="quiet" type="submit">{t("restore")}</button></form></div></div></li>')
                    continue
                remove = (f'<a class="quiet" href="/katalog/remove?{escape(urlencode({"id": fid, "next": here, **({"lang": explicit} if explicit else {})}))}" data-rm data-id="{fid}" '
                          f'data-csrf="{app.csrf(fid)}" data-next="{escape(here)}" data-name="{escape(row["name"])}">{ICON_TRASH}{t("remove")}</a>')
                if available:
                    name = filename(row)
                    if not name.lower().endswith(('.3mf', '.stl', '.stp', '.step', '.obj')) and row['file_type'] in ALL_TYPES:
                        name += '.' + row['file_type']
                    url = base + f'/katalog/signed/{fid}/{app.token(fid)}/' + slicer_url_name(name)
                    encoded = quote(url, safe='')
                    parts.append(f'<div class="actions"><a href="/katalog/download/{fid}">{t("download")}</a>')
                    links = []
                    for label, prefix, types in SLICERS:
                        if row['file_type'] in types:
                            mac = f' data-mac="{escape("bambustudioopen://" + encoded)}"' if label == 'Bambu Studio' else ''
                            links.append(f'<li><a href="{escape(prefix + encoded)}"{mac}>{label}</a></li>')
                    if links:
                        parts.append(f'<details{" open" if single else ""}><summary>{t("slicer")}</summary><ul>{"".join(links)}</ul></details>')
                    parts.append(remove + '</div>')
                else:
                    parts.append(f'<p>{t("unavailable")}</p><div class="actions">{remove}</div>')
                parts.append('</div></li>')
            parts.append('</ul>')
            if not rows:
                parts.append(f'<p>{t("hidden_empty") if view_hidden else t("empty")}</p>')
            if not single:
                parts.append(f'<nav aria-label="{t("page")}"><span>{t("page")} {page}</span>')
                for number, label, show in [(page - 1, 'previous', page > 1), (page + 1, 'next', more)]:
                    if show:
                        target = '/katalog/?' + urlencode({**{k: v for k, v in query.items() if k != 'removed'}, 'page': number})
                        parts.append(f'<a href="{escape(target)}">{t(label)}</a>')
                parts.append('</nav>')
            if not view_hidden:
                # One shared dialog; the script fills it per file. Without script the links open the confirmation page.
                parts.append(f'<dialog id="rm-dialog" aria-labelledby="rm-title"><div class="dlg"><h2 id="rm-title">{t("remove_title")}</h2>'
                             f'<p class="dlg-name" data-rm-name></p><p>{t("remove_explain")}</p>'
                             f'<form method="post" action="/katalog/remove"><input type="hidden" name="id" value=""><input type="hidden" name="csrf" value="">'
                             f'<input type="hidden" name="next" value=""><div class="dlg-actions"><button type="button" class="secondary" data-rm-cancel autofocus>{t("cancel")}</button>'
                             f'<button type="submit">{t("remove_confirm")}</button></div></form></div></dialog>')
        parts.append(f'</main><script>{SCRIPT}{UPLOAD_SCRIPT}</script></body></html>')
        self.respond(status, ''.join(parts).encode(), 'text/html; charset=utf-8')


def main():
    os.umask(0o022)
    port = int(os.environ.get('KATALOG_WEB_PORT', '8099'))
    if not 1 <= port <= 65535:
        raise ValueError('Invalid port')
    server = http.server.ThreadingHTTPServer(('127.0.0.1', port), Handler)
    server.catalog = Catalog()
    print(f'Katalog web listening on 127.0.0.1:{port}', flush=True)
    server.serve_forever()


if __name__ == '__main__':
    main()
