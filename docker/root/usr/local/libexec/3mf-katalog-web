def _font_faces():
    return ''.join("@font-face{font-family:'Barlow';font-style:normal;font-weight:%d;font-display:swap;"
                   "src:url(/katalog/static/fonts/barlow-%d.woff2) format('woff2')}" % (w, w)
                   for w in (400, 500, 600, 700))


