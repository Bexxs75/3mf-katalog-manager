#!/usr/bin/python3
"""Read-only catalog companion, served behind the authenticated nginx proxy."""
import contextlib
import hashlib
import hmac
import html
import http.server
import ipaddress
import os
from pathlib import Path
import re
import secrets
import sqlite3
import stat
import time
import unicodedata
from urllib.parse import parse_qs, quote, urlencode, urlsplit

BLOCK_SIZE = 64 * 1024
PAGE_SIZE = 50
ID = r'[0-9]{1,19}'
CSP = ("default-src 'none'; img-src 'self'; style-src 'self' 'unsafe-inline'; "
       "script-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'")
MIME = {'3mf': 'model/3mf', 'stl': 'model/stl', 'obj': 'model/obj', 'stp': 'model/step', 'step': 'model/step'}
ALL_TYPES = {'3mf', 'stl', 'obj', 'stp', 'step'}
SLICERS = (
    ('OrcaSlicer', 'orcaslicer://open?file=', ALL_TYPES),
    ('Bambu Studio', 'bambustudio://open?file=', {'3mf'}),
    ('Creality Print', 'crealityprintlink://open?file=', ALL_TYPES),
    ('ElegooSlicer', 'elegooslicer://open?file=', ALL_TYPES),
    ('Cura', 'cura://open?file=', {'3mf', 'stl', 'obj'}),
    ('Lychee', 'lycheeslicer://open/', {'3mf', 'stl', 'obj'}),
    ('SuperSlicer', 'prusaslicer://open?file=', ALL_TYPES),
)
TEXT = {
    'title': ('Download und Slicer', 'Download and slicer'),
    'missing': ('Katalog noch nicht angelegt – zuerst in der App einrichten. Falls bereits eingerichtet: Datenbankpfad, Leserechte und App-Version prüfen.',
                'Catalog not created – set it up in the app first. If already configured, check the database path, read permissions and app version.'),
    'search': ('Name suchen', 'Search name'), 'type': ('Dateityp', 'File type'),
    'folder': ('Ordner', 'Folder'), 'tag': ('Tag', 'Tag'), 'sort': ('Sortierung', 'Sort'),
    'name': ('Name', 'Name'), 'newest': ('Neueste', 'Newest'), 'size': ('Größe', 'Size'),
    'apply': ('Anwenden', 'Apply'), 'all': ('Alle', 'All'),
    'download': ('Herunterladen', 'Download'), 'slicer': ('In Slicer öffnen', 'Open in slicer'),
    'unavailable': ('Datei nicht verfügbar oder außerhalb der Modell-Ordner', 'File unavailable or outside model folders'),
    'empty': ('Keine Dateien gefunden.', 'No files found.'),
    'previous': ('Zurück', 'Previous'), 'next': ('Weiter', 'Next'), 'page': ('Seite', 'Page'),
    'help': ('Hilfe zu Slicern', 'Slicer help'),
    'expiry': ('Links gelten 1 Stunde. Bei einem Fehler die Seite neu laden.', 'Links expire after 1 hour. Reload this page if a link fails.'),
    'prusa': ('PrusaSlicer: Datei herunterladen und im Slicer öffnen.', 'PrusaSlicer: download the file and open it in the slicer.'),
    'advice': ('Der Slicer muss auf deinem PC installiert und die Adresse vom PC erreichbar sein. Selbstsignierte Zertifikate bei https://…:3001 werden oft abgelehnt: im Heimnetz http://…:3000 oder einen Reverse Proxy mit gültigem Zertifikat verwenden. Unter Linux muss das URL-Schema registriert sein.',
               'The slicer must be installed on your PC and the address must be reachable from that PC. Slicers often reject self-signed certificates at https://…:3001: use http://…:3000 on your home network or a reverse proxy with a valid certificate. On Linux the URL scheme must be registered.'),
    'error': ('Anfrage nicht verfügbar.', 'Request unavailable.'),
}
STYLE = '''
:root {color-scheme:light dark;font-family:system-ui,sans-serif;background:#f5f6f8;color:#202632}
body {max-width:76rem;margin:auto;padding:1rem} a {color:#075cba} button,input,select {font:inherit;padding:.5rem;max-width:100%}
form {display:flex;flex-wrap:wrap;gap:.8rem;align-items:end;margin:1.5rem 0} label {display:grid;gap:.3rem}
