# Before the first stable image release, set rc or a specific published version (without v).
# Vor dem ersten stabilen Image-Release rc oder eine konkrete veröffentlichte Version (ohne v) setzen.
# Compose also defaults to latest / Auch Compose verwendet standardmäßig latest.
IMAGE_TAG=latest
PUID=1000
PGID=1000
TZ=Europe/Berlin
UMASK=022
MODELS_DIR=./models
CUSTOM_USER=abc
# Leave empty to generate a password / Leer lassen für ein erzeugtes Passwort.
PASSWORD=
ALLOW_NO_AUTH=false
# Only for local builds / Nur für lokale Builds: matching release URL + version.
# Put ONLY the address after the equals sign, do not repeat "APP_URL=" in the value.
# Nur die Adresse hinter das Gleichheitszeichen schreiben, "APP_URL=" nicht noch einmal im Wert wiederholen.
# Example / Beispiel:
# APP_URL=https://github.com/Bexxs75/3mf-katalog-manager/releases/download/v0.16.0/3MF-Katalog-Manager-0.16.0-Linux-x86_64.AppImage
# APP_VERSION=0.16.0
BASE_IMAGE=ghcr.io/linuxserver/baseimage-selkies:ubuntunoble@sha256:7cab02f9222937ad1e704cd904534d69a2300b2406af466241817be0ce1d0493
APP_URL=
APP_VERSION=
# Optional fixed browser origin; uncomment the Compose line too.
# Optionale feste Browser-Adresse; auch die Compose-Zeile einkommentieren.
# KATALOG_PUBLIC_URL=https://katalog.example.de
# Optional uploads; uncomment the corresponding Compose lines too.
# Optionale Uploads; auch die entsprechenden Compose-Zeilen einkommentieren.
# Empty values use service defaults: /models/Eingang and 2048 MiB.
# Leere Werte verwenden Dienst-Standards: /models/Eingang und 2048 MiB.
# KATALOG_UPLOAD_DIR=/models/Eingang
# KATALOG_UPLOAD_MAX_MB=2048
