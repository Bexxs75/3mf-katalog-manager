{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "types": ["node", "mocha", "@wdio/globals/types", "@wdio/mocha-framework"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["**/*.ts", "fixtures/*.mjs"],
  "exclude": ["node_modules", "out"]
}
