  "cards": [
    {
      "dot": "cyan",
      "title": "Frontend",
      "items": [
        "React 19 + TypeScript + Tailwind im Tauri-WebView; Schriften lokal gebündelt",
        "Neu: Printer Manager (Drucker, Materialeinheiten, Verbindung) und Material Manager als eigene Ansichten; Import mit Fortschritt und Abbrechen",
        "3D-Vorschau mit Plattenwahl für 3MF-Dateien; ohne WebGL eine Fehlermeldung statt Absturz"
      ]
    },
    {
      "dot": "emerald",
      "title": "Backend & Persistenz",
      "items": [
        "19 fachliche Rust-Module; neu: Importdienst mit Warteschlange, Abbruch und Savepoints je Datei",
        "Native Parser für 3MF/STL/OBJ, STEP über OCCT (ein Paket pro System); sie laufen im Import und direkt für die 3D-Vorschau; Archive werden entpackt",
        "Ein SQLite-Katalog; vor jeder Schema-Migration und jedem Update eine Sicherungskopie"
      ]
    },
    {
      "dot": "amber",
      "title": "Lokal-first, drei Wege nach außen",
      "items": [
        "Updates von GitHub, mit Signatur geprüft; latest.json und latest-step.json zeigen auf dieselben Pakete",
        "Druckeranbindung nur im Heimnetz und nur lesend (Klipper/Moonraker); Bambu und OctoPrint folgen später",
        "„Fehler melden“ öffnet 3mfkatalog.de; die Logdatei wird vorher anonymisiert"
      ]
    }
  ]
