# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Cloud OAuth credentials, never commit
/cloud.config.json

# Windows: OCCT runtime DLLs staged from vcpkg at build time (see
# scripts/stage-occt-dlls.ps1). Deliberately not committed - see
# vendor/opencascade-sys/VENDORING.md for the rationale.
/occt-runtime/

# vcpkg install output when building locally in the manifest directory (see
# occt-vcpkg-manifest/README.md). Only the manifest itself is part of the repo,
# not the libraries built from it.
/occt-vcpkg-manifest/vcpkg_installed/
