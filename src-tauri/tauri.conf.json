{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "3MF Katalog Manager",
  "version": "0.15.1",
  "identifier": "com.thebexxs.mfkatalogmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "3MF Katalog Manager",
        "width": 1000,
        "height": 600,
        "minWidth": 900,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "resources": {
      "../THIRD-PARTY-LICENSES.md": "THIRD-PARTY-LICENSES.md",
      "LICENSES/*": "LICENSES/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwQzU2MDQwNjdFRjlGMDUKUldRRm4rOW5RR0RGSUhxaFc5TEwxK0ppZnJCUjY2eXdVWGhtK0k5cjdPcGdnbFkyOS8razNkT0QK",
      "endpoints": [
        "https://github.com/Bexxs75/3mf-katalog-manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
